# Bluetooth
persist.vendor.bluetooth.modem_nv_support=true
persist.vendor.btstack.enable.gatt_robust_caching=false

# Display
persist.sys.brightness.low.gamma=true

# Nothing Features
ro.build.nothing.feature.base=0xe24800001004458438124a040106b4247b97ffL
ro.build.nothing.feature.diff.device.Spacewar=0x82000000440000401aa4142ac041a032c34800L

# Sensors
persist.vendor.sensors.enable.mag_filter=true
